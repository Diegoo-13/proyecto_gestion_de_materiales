<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane
    maxHeight="-Infinity"
    maxWidth="-Infinity"
    minHeight="-Infinity"
    minWidth="-Infinity"
    prefHeight="550.0"
    prefWidth="700.0"
    style="-fx-background-color: #F4F7FC;"
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="utng.gtid2.dab.controllers.prestamos.NuevoPrestamoController">

    <children>

        <!-- ================================================= -->
        <!-- TÍTULO -->
        <!-- ================================================= -->

        <Label
            layoutX="14.0"
            layoutY="11.0"
            text="Nuevo Préstamo">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="25.0" />
            </font>

        </Label>


        <!-- ================================================= -->
        <!-- SEPARADOR -->
        <!-- ================================================= -->

        <Separator
            layoutY="55.0"
            prefHeight="2.0"
            prefWidth="700.0" />


        <!-- ================================================= -->
        <!-- NOMBRE DEL RESPONSABLE -->
        <!-- ================================================= -->

        <Label
            layoutX="43.0"
            layoutY="97.0"
            text="Nombre del responsable"
            textFill="#374151">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="14.0" />
            </font>

        </Label>


        <TextField
            fx:id="txtResponsable"
            layoutX="43.0"
            layoutY="119.0"
            prefHeight="35.0"
            prefWidth="250.0"
            promptText="Nombre del Responsable..."
            AnchorPane.bottomAnchor="396.2"
            AnchorPane.topAnchor="119.0" />


        <!-- ================================================= -->
        <!-- MATERIAL -->
        <!-- ================================================= -->

        <Label
            layoutX="403.0"
            layoutY="97.0"
            text="Material"
            textFill="#374151">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="14.0" />
            </font>

        </Label>


        <ComboBox
            fx:id="cmbMaterial"
            layoutX="403.0"
            layoutY="119.0"
            prefHeight="35.0"
            prefWidth="250.0" />


        <!-- ================================================= -->
        <!-- BOTÓN CERRAR -->
        <!-- ================================================= -->

        <Button
            fx:id="btnCerrar"
            layoutX="661.0"
            layoutY="13.0"
            mnemonicParsing="false"
            onAction="#cerrarVentana"
            style="-fx-background-color: #ff0000; -fx-background-radius: 8;"
            text="X"
            textFill="WHITE">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="15.0" />
            </font>

        </Button>


        <!-- ================================================= -->
        <!-- TELÉFONO -->
        <!-- ================================================= -->

        <Label
            layoutX="43.0"
            layoutY="161.0"
            text="Teléfono"
            textFill="#374151">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="14.0" />
            </font>

        </Label>


        <TextField
            fx:id="txtTelefono"
            layoutX="43.0"
            layoutY="180.0"
            prefHeight="35.0"
            prefWidth="250.0"
            promptText="Número de teléfono..." />


        <!-- ================================================= -->
        <!-- CANTIDAD -->
        <!-- ================================================= -->

        <Label
            layoutX="43.0"
            layoutY="224.0"
            text="Cantidad"
            textFill="#374151">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="14.0" />
            </font>

        </Label>


        <TextField
            fx:id="txtCantidad"
            layoutX="43.0"
            layoutY="243.0"
            prefHeight="35.0"
            prefWidth="250.0"
            promptText="Ingresa la cantidad" />


        <!-- ================================================= -->
        <!-- FECHA PRÉSTAMO -->
        <!-- ================================================= -->

        <Label
            layoutX="403.0"
            layoutY="161.0"
            text="Fecha préstamo"
            textFill="#374151">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="14.0" />
            </font>

        </Label>


        <DatePicker
            fx:id="dpFechaPrestamo"
            disable="true"
            layoutX="403.0"
            layoutY="180.0"
            prefHeight="35.0"
            prefWidth="250.0" />


        <!-- ================================================= -->
        <!-- FECHA DEVOLUCIÓN -->
        <!-- ================================================= -->

        <Label
            layoutX="46.0"
            layoutY="291.0"
            text="Fecha devolución"
            textFill="#374151">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="14.0" />
            </font>

        </Label>


        <DatePicker
            fx:id="dpFechaDevolucion"
            layoutX="43.0"
            layoutY="309.0"
            prefHeight="35.0"
            prefWidth="250.0" />


        <!-- ================================================= -->
        <!-- HORA DEVOLUCIÓN -->
        <!-- ================================================= -->

        <Label
            layoutX="402.0"
            layoutY="224.0"
            text="Hora devolución"
            textFill="#374151">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="14.0" />
            </font>

        </Label>


        <ComboBox
            fx:id="cmbHoraDevolucion"
            layoutX="403.0"
            layoutY="242.0"
            prefHeight="35.0"
            prefWidth="250.0" />


        <!-- ================================================= -->
        <!-- OBSERVACIONES -->
        <!-- ================================================= -->

        <Label
            layoutX="45.0"
            layoutY="354.0"
            text="Observaciones (opcional)"
            textFill="#374151">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="14.0" />
            </font>

        </Label>


        <TextArea
            fx:id="txtaObservaciones"
            layoutX="45.0"
            layoutY="372.0"
            prefHeight="110.0"
            prefWidth="610.0"
            promptText="Escriba alguna observación..." />


        <!-- ================================================= -->
        <!-- BOTÓN CANCELAR -->
        <!-- ================================================= -->

        <Button
            fx:id="btnCancelar"
            layoutX="325.0"
            layoutY="498.0"
            mnemonicParsing="false"
            onAction="#cancelarPrestamo"
            prefHeight="30.0"
            prefWidth="130.0"
            style="-fx-background-color: #ff0000; -fx-background-radius: 8;"
            text="Cancelar"
            textFill="WHITE">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="15.0" />
            </font>

        </Button>


        <!-- ================================================= -->
        <!-- BOTÓN REGISTRAR -->
        <!-- ================================================= -->

        <Button
            fx:id="btnRegistrarPrestamo"
            layoutX="496.0"
            layoutY="498.0"
            mnemonicParsing="false"
            onAction="#registrarPrestamo"
            prefHeight="30.0"
            prefWidth="162.0"
            style="-fx-background-color: #2563EB; -fx-background-radius: 8;"
            text="Registrar Préstamo"
            textFill="WHITE">

            <font>
                <Font
                    name="Segoe UI Bold"
                    size="15.0" />
            </font>

        </Button>

    </children>

</AnchorPane>