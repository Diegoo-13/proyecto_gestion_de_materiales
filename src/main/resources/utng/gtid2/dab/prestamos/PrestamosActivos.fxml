<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" stylesheets="@../css/estilos.css" style="-fx-background-color:#F4F7FC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid2.dab.controllers.prestamos.PrestamosActivosController">

    <!-- ================= MENÚ LATERAL ================= -->

    <left>

        <VBox prefWidth="220" spacing="10" styleClass="sidebar">

            <padding>
                <Insets bottom="20" left="10" right="10" top="20" />
            </padding>

            <!-- Menú -->

            <Button fx:id="btnInicio" onAction="#inicio" prefHeight="40" prefWidth="200" styleClass="menu-button" text="Inicio">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" top="120.0" />
            </VBox.margin></Button>

            <Button fx:id="btnMaterialesRegistrados" onAction="#materialesRegistrados" prefHeight="40" prefWidth="200.0" styleClass="menu-button" text="Materiales Registrados">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin></Button>

            <!-- Seleccionado -->

            <Button fx:id="btnPrestamosActivos" onAction="#prestamosActivos" prefHeight="40.0" prefWidth="200" styleClass="menu-button" text="Préstamos Activos">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin></Button>

            <Button fx:id="btnMaterialesDanados" onAction="#materialesDanados" prefHeight="40" prefWidth="200" styleClass="menu-button" text="Materiales Dañados">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin></Button>

            <Button fx:id="btnReportes" onAction="#reportes" prefHeight="40" prefWidth="200" styleClass="menu-button" text="Reportes">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin></Button>

            <Button fx:id="btnUsuarios" onAction="#usuarios" prefHeight="40" prefWidth="200" styleClass="menu-button" text="Usuarios">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin></Button>

            <Pane VBox.vgrow="ALWAYS" />

            <Button fx:id="btnCuenta" onAction="#cuenta" prefHeight="40" prefWidth="200" styleClass="menu-button" text="Cuenta">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font></Button>

        </VBox>

    </left>

    <!-- ================= CONTENIDO ================= -->

    <center>

        <VBox spacing="18" style="-fx-padding:20;">

            <!-- Encabezado -->

            <HBox alignment="CENTER_LEFT">

                <VBox spacing="4">

                    <Label style="-fx-text-fill: #1F2937;" text="Préstamos Activos">
                  <font>
                     <Font name="Segoe UI Bold" size="30.0" />
                  </font></Label>

                    <Label style="-fx-text-fill: #6B7280;" text="Consulta y administra los préstamos actualmente activos.">
                  <font>
                     <Font name="Segoe UI" size="13.0" />
                  </font></Label>

                </VBox>

                <Pane HBox.hgrow="ALWAYS" />

                <!-- Fecha -->

                <HBox alignment="CENTER" prefHeight="60.0" prefWidth="200.0" spacing="10" style="-fx-background-color:white;                              -fx-background-radius:10;                              -fx-border-color:#E5E7EB;                              -fx-border-radius:10;                              -fx-padding:12;">
               <Label fx:id="lblHora" text="HORA" textFill="#6b7280">
                  <font>
                     <Font name="Segoe UI Bold" size="15.0" />
                  </font>
               </Label>

                    <VBox>

                        <Label style="-fx-text-fill:#6B7280;                                       -fx-font-size:11;" />

                    </VBox>
               <Label fx:id="lblFecha" layoutX="86.0" layoutY="31.0" text="FECHA" textFill="#6b7280">
                  <font>
                     <Font name="Segoe UI Bold" size="15.0" />
                  </font>
               </Label>

                </HBox>

            </HBox>

                       <!-- ================= FILTROS ================= -->

            <HBox alignment="BOTTOM_LEFT" prefHeight="113.0" prefWidth="1106.0" spacing="15">

                <!-- Buscar -->

                <VBox spacing="5">

                    <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Buscar">
                  <font>
                     <Font name="Segoe UI Bold" size="17.0" />
                  </font></Label>

                    <TextField fx:id="txtBuscar" prefHeight="35.0" prefWidth="260" promptText="Buscar por Folio" />

                </VBox>

                <!-- Estado -->

                <VBox spacing="5">

                    <Label text="Estado">
                  <font>
                     <Font name="Segoe UI Bold" size="17.0" />
                  </font></Label>

                    <ComboBox fx:id="cbEstado" prefHeight="35.0" prefWidth="150" promptText="Todos" />

                </VBox>

                <!-- Responsable -->

                <VBox spacing="5">

                    <Label text="Responsable">
                  <font>
                     <Font name="Segoe UI Bold" size="17.0" />
                  </font></Label>

                    <TextField fx:id="txtResponsable" prefHeight="35.0" prefWidth="180" promptText="Nombre" />

                </VBox>

                <!-- Desde -->

                <VBox spacing="5">

                    <Label text="Desde">
                  <font>
                     <Font name="Segoe UI Bold" size="17.0" />
                  </font></Label>

                    <DatePicker fx:id="dpDesde" prefHeight="35.0" prefWidth="140" />

                </VBox>

                <!-- Hasta -->

                <VBox spacing="5">

                    <Label text="Hasta">
                  <font>
                     <Font name="Segoe UI Bold" size="17.0" />
                  </font></Label>

                    <DatePicker fx:id="dpHasta" prefHeight="35.0" prefWidth="140" />

                </VBox>

            </HBox>

            <!-- Botones Buscar / Limpiar -->

            <HBox prefHeight="73.0" prefWidth="1106.0" spacing="10">

                <Button fx:id="btnBuscar" onAction="#buscar" prefHeight="35.0" prefWidth="120" style="-fx-background-color: #2563EB; -fx-background-radius: 8;" text="🔍 Buscar" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="15.0" />
               </font></Button>

                <Button fx:id="btnLimpiar" onAction="#limpiar" prefHeight="35.0" prefWidth="120" style="-fx-background-color:white;                                -fx-border-color:#D1D5DB;                                -fx-border-radius:8;                                -fx-background-radius:8;" text="↻ Limpiar">
               <font>
                  <Font name="Segoe UI" size="15.0" />
               </font></Button>
            <VBox.margin>
               <Insets top="-20.0" />
            </VBox.margin>

            </HBox>

            <!-- ================= TARJETAS KPI ================= -->

            <HBox prefHeight="104.0" prefWidth="1106.0" spacing="18">

                <!-- Vence Hoy -->

                <VBox prefHeight="104.0" prefWidth="260.0" spacing="8" style="-fx-background-color: #EEF4FF; -fx-padding: 18; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #C7DAFF;">

                    <Label text="Préstamos activos">
                  <font>
                     <Font name="Segoe UI Bold" size="15.0" />
                  </font></Label>

                    <Label style="-fx-font-size:34;                                   -fx-font-weight:bold;                                   -fx-text-fill:#F59E0B;">
                  <graphic>
                     <Label fx:id="lblPrestamosActivos" alignment="CENTER" prefWidth="320.0" text="0" textFill="#1d4ed8" />
                  </graphic></Label>

                </VBox>
            <VBox layoutX="10.0" layoutY="10.0" prefHeight="104.0" prefWidth="260.0" spacing="8" style="-fx-background-color: #E8F5E9; -fx-padding: 18; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #81C784;">
               <children>
                  <Label text="Préstamos devueltos">
                     <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                     </font>
                  </Label>
                  <Label style="-fx-font-size:34;                                   -fx-font-weight:bold;                                   -fx-text-fill:#F59E0B;">
                     <graphic>
                        <Label fx:id="lblPrestamosDevueltos" alignment="CENTER" prefWidth="320.0" text="0" textFill="#249642" />
                     </graphic>
                  </Label>
               </children>
            </VBox>
            <VBox layoutX="10.0" layoutY="10.0" prefHeight="104.0" prefWidth="260.0" spacing="8" style="-fx-background-color:#FFF8E8;                              -fx-padding:18;                              -fx-background-radius:10;                              -fx-border-radius:10;                              -fx-border-color:#F3D37C;">
               <children>
                  <Label text="Vence hoy">
                     <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                     </font>
                  </Label>
                  <Label style="-fx-font-size:34;                                   -fx-font-weight:bold;                                   -fx-text-fill:#F59E0B;">
                     <graphic>
                        <Label fx:id="lblVenceHoy" alignment="CENTER" prefWidth="320.0" text="0" textFill="#d97706" />
                     </graphic>
                  </Label>
               </children>
            </VBox>

                <!-- Vencidos -->

                <VBox prefHeight="104.0" prefWidth="260.0" spacing="8" style="-fx-background-color:#FFF1F1;                              -fx-padding:18;                              -fx-background-radius:10;                              -fx-border-radius:10;                              -fx-border-color:#F2B0B0;">

                    <Label text="Préstamos vencidos">
                  <font>
                     <Font name="Segoe UI Bold" size="15.0" />
                  </font></Label>

                    <Label style="-fx-font-size:34;                                   -fx-font-weight:bold;                                   -fx-text-fill:#DC2626;">
                  <graphic>
                     <Label fx:id="lblPrestamosVencidos" alignment="CENTER" prefWidth="320.0" text="0" textFill="#dc2626" />
                  </graphic></Label>

                </VBox>
            <VBox.margin>
               <Insets top="-10.0" />
            </VBox.margin>

            </HBox>

                        <!-- ================= TABLA ================= -->

            <VBox prefHeight="400.0" prefWidth="1106.0" spacing="10" VBox.vgrow="ALWAYS">

                <TableView fx:id="tblPrestamos" prefHeight="400.0" prefWidth="1106.0" style="-fx-background-color:white;                                   -fx-background-radius:10;                                   -fx-border-color:#E5E7EB;                                   -fx-border-radius:10;" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colFolio" prefWidth="80.0" text="Folio" />

                        <TableColumn fx:id="colResponsable" prefWidth="220.0" text="Responsable" />
                  <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Teléfono" />

                        <TableColumn fx:id="colMaterial" prefWidth="203.0" text="Material" />

                        <TableColumn fx:id="colCantidad" text="Cantidad" />

                        <TableColumn fx:id="colFechaPrestamo" prefWidth="150.0" text="Fecha préstamo" />

                        <TableColumn fx:id="colFechaDevolucion" prefWidth="150.0" text="Fecha devolución" />
                  <TableColumn fx:id="colHoraDevolucion" prefWidth="100.0" text="Hora devolución" />

                        <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />

                    </columns>

                </TableView>
            <VBox.margin>
               <Insets bottom="-20.0" top="-10.0" />
            </VBox.margin>

            </VBox>

            <!-- ================= BOTONES ================= -->

            <HBox alignment="CENTER_RIGHT" spacing="15">
            <Pane prefHeight="87.0" prefWidth="700.0">
               <children>
      
                      <Button fx:id="btnNuevoPrestamo" layoutX="500.0" layoutY="4.0" onAction="#nuevoPrestamo" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;" text="➕ Nuevo Préstamo" textFill="WHITE">
                     <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                     </font>
                  </Button>
         
                                     <Button fx:id="btnMarcarDevuelto" layoutX="250.0" layoutY="4.0" onAction="#devuelto" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #16A34A; -fx-border-radius: 8; -fx-background-radius: 8;" text="✔ Marcar como devuelto" textFill="WHITE">
                     <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                     </font>
                  </Button>
               </children></Pane>
            <VBox.margin>
               <Insets top="15.0" />
            </VBox.margin>

            </HBox>

        </VBox>

    </center>

</BorderPane>
