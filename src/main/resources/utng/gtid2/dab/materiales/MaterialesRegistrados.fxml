<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" stylesheets="@../css/estilos.css" style="-fx-background-color: #F4F7FC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid2.dab.controllers.materiales.MaterialesRegistradosController">
        <center>

    <VBox spacing="18" style="-fx-padding:20;">

        <!-- ================= ENCABEZADO ================= -->

        <HBox alignment="CENTER_LEFT">

            <VBox spacing="4">

                <Label text="Materiales Registrados">
                    <font>
                        <Font name="Segoe UI Bold" size="30.0" />
                    </font>
                </Label>

                <Label
                    style="-fx-text-fill: #6B7280;"
                    text="Consulta y administra los materiales registrados en el inventario.">
                    <font>
                        <Font name="Segoe UI" size="13.0" />
                    </font>
                </Label>

            </VBox>

            <Pane HBox.hgrow="ALWAYS" />

            <!-- ================= HORA Y FECHA ================= -->

            <HBox
                fx:id="lblHoraFecha"
                alignment="CENTER"
                prefHeight="60.0"
                prefWidth="200.0"
                spacing="10"
                style="-fx-background-color:white;
                       -fx-background-radius:10;
                       -fx-border-color:#E5E7EB;
                       -fx-border-radius:10;
                       -fx-padding:12;">

                <Label
                    fx:id="lblHora"
                    text="HORA"
                    textFill="#6b7280">
                    <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                    </font>
                </Label>

                <VBox>
                    <Label
                        style="-fx-text-fill:#6B7280;
                               -fx-font-size:11;" />
                </VBox>

                <Label
                    fx:id="lblFecha"
                    text="FECHA"
                    textFill="#6b7280">
                    <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                    </font>
                </Label>

            </HBox>

        </HBox>


        <!-- ================= FILTROS ================= -->

        <HBox
            alignment="BOTTOM_LEFT"
            spacing="15"
            VBox.vgrow="NEVER">

            <!-- Buscar -->

            <VBox spacing="5">

                <Label text="Buscar">
                    <font>
                        <Font name="Segoe UI Bold" size="17.0" />
                    </font>
                </Label>

                <TextField
                    fx:id="txtBuscarMaterial"
                    onAction="#buscarMaterial"
                    prefHeight="35.0"
                    prefWidth="260.0"
                    promptText="Ingrese ID o Nombre del material"
                    style="-fx-background-radius:5;">
                    <font>
                        <Font size="16.0" />
                    </font>
                </TextField>

            </VBox>


            <!-- Categoría -->

            <VBox spacing="5">

                <Label text="Categoría">
                    <font>
                        <Font name="Segoe UI Bold" size="17.0" />
                    </font>
                </Label>

                <ComboBox
                    fx:id="cmbCategoria"
                    prefHeight="35.0"
                    prefWidth="150.0"
                    promptText="Todas" />

            </VBox>


            <!-- Tipo -->

            <VBox spacing="5">

                <Label text="Tipo">
                    <font>
                        <Font name="Segoe UI Bold" size="17.0" />
                    </font>
                </Label>

                <ComboBox
                    fx:id="cmbTipo"
                    prefHeight="35.0"
                    prefWidth="150.0"
                    promptText="Todos" />

            </VBox>


            <!-- Stock -->

            <VBox spacing="5">

                <Label text="Stock">
                    <font>
                        <Font name="Segoe UI Bold" size="17.0" />
                    </font>
                </Label>

                <ComboBox
                    fx:id="cmbStock"
                    prefHeight="35.0"
                    prefWidth="150.0"
                    promptText="Todos" />

            </VBox>


            <!-- Espacio flexible -->

            <Pane HBox.hgrow="ALWAYS" />


            <!-- Buscar -->

            <Button
                fx:id="btnBuscarMaterial"
                onAction="#buscarMaterial"
                prefHeight="35.0"
                prefWidth="120.0"
                style="-fx-background-color:#2563EB;
                       -fx-background-radius:8;"
                text="Buscar"
                textFill="WHITE">

                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>

            </Button>


            <!-- Limpiar -->

            <Button
                fx:id="btnLimpiar"
                onAction="#limpiar"
                prefHeight="37.0"
                prefWidth="120.0"
                style="-fx-background-color:white;
                       -fx-border-color:#D1D5DB;
                       -fx-border-radius:8;
                       -fx-background-radius:8;"
                text="↻ Limpiar">

                <font>
                    <Font name="Segoe UI" size="15.0" />
                </font>

            </Button>

        </HBox>


        <!-- ================= TARJETAS ================= -->

        <HBox
            spacing="18"
            VBox.vgrow="NEVER">

            <!-- Materiales registrados -->

            <VBox
                prefHeight="104.0"
                prefWidth="260.0"
                HBox.hgrow="ALWAYS"
                spacing="8"
                style="-fx-background-color:#EEF4FF;
                       -fx-padding:18;
                       -fx-background-radius:10;
                       -fx-border-radius:10;
                       -fx-border-color:#C7DAFF;">

                <Label text="Materiales Registrados">
                    <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                    </font>
                </Label>

                <Label>
                    <graphic>
                        <Label
                            fx:id="lblMaterialesRegistrados"
                            alignment="CENTER"
                            prefWidth="320.0"
                            text="0"
                            textFill="#1d4ed8"
                            style="-fx-font-size:34;
                                   -fx-font-weight:bold;" />
                    </graphic>
                </Label>

            </VBox>


            <!-- Activos -->

            <VBox
                prefHeight="104.0"
                prefWidth="260.0"
                HBox.hgrow="ALWAYS"
                spacing="8"
                style="-fx-background-color:#E8F5E9;
                       -fx-padding:18;
                       -fx-background-radius:10;
                       -fx-border-radius:10;
                       -fx-border-color:#81C784;">

                <Label text="Activos">
                    <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                    </font>
                </Label>

                <Label>
                    <graphic>
                        <Label
                            fx:id="lblActivos"
                            alignment="CENTER"
                            prefWidth="320.0"
                            text="0"
                            textFill="#249642"
                            style="-fx-font-size:34;
                                   -fx-font-weight:bold;" />
                    </graphic>
                </Label>

            </VBox>


            <!-- Consumibles -->

            <VBox
                prefHeight="104.0"
                prefWidth="260.0"
                HBox.hgrow="ALWAYS"
                spacing="8"
                style="-fx-background-color:#FFF8E8;
                       -fx-padding:18;
                       -fx-background-radius:10;
                       -fx-border-radius:10;
                       -fx-border-color:#F3D37C;">

                <Label text="Consumibles">
                    <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                    </font>
                </Label>

                <Label>
                    <graphic>
                        <Label
                            fx:id="lblConsumibles"
                            alignment="CENTER"
                            prefWidth="320.0"
                            text="0"
                            textFill="#d97706"
                            style="-fx-font-size:34;
                                   -fx-font-weight:bold;" />
                    </graphic>
                </Label>

            </VBox>


            <!-- Stock bajo -->

            <VBox
                prefHeight="104.0"
                prefWidth="260.0"
                HBox.hgrow="ALWAYS"
                spacing="8"
                style="-fx-background-color:#FFF1F1;
                       -fx-padding:18;
                       -fx-background-radius:10;
                       -fx-border-radius:10;
                       -fx-border-color:#F2B0B0;">

                <Label text="Stock Bajo">
                    <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                    </font>
                </Label>

                <Label>
                    <graphic>
                        <Label
                            fx:id="lblStockBajo"
                            alignment="CENTER"
                            prefWidth="320.0"
                            text="0"
                            textFill="#dc2626"
                            style="-fx-font-size:34;
                                   -fx-font-weight:bold;" />
                    </graphic>
                </Label>

            </VBox>

        </HBox>


        <!-- ================= TABLA ================= -->

        <VBox
            spacing="10"
            VBox.vgrow="ALWAYS">

            <TableView
                fx:id="tblMateriales"
                prefHeight="399.0"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color:white;
                       -fx-background-radius:10;
                       -fx-border-color:#E5E7EB;
                       -fx-border-radius:10;">

                <columns>

                    <TableColumn
                        fx:id="colId"
                        prefWidth="57.0"
                        text="ID" />

                    <TableColumn
                        fx:id="colNombre"
                        prefWidth="220.0"
                        text="Nombre" />

                    <TableColumn
                        fx:id="colCategoria"
                        prefWidth="170.0"
                        text="Categoría" />

                    <TableColumn
                        fx:id="colTipo"
                        prefWidth="120.0"
                        text="Tipo" />

                    <TableColumn
                        fx:id="colCantidad"
                        prefWidth="100.0"
                        text="Cantidad" />

                    <TableColumn
                        fx:id="colStockMinimo"
                        prefWidth="90.0"
                        text="Mínimo" />

                    <TableColumn
                        fx:id="colEstado"
                        prefWidth="140.0"
                        text="Estado" />

                    <TableColumn
                        fx:id="colUbicacion"
                        prefWidth="200.0"
                        text="Ubicación" />

                </columns>

            </TableView>

        </VBox>


        <!-- ================= BOTONES ================= -->

        <HBox
            alignment="CENTER_RIGHT"
            spacing="15">

            <Button
                fx:id="btnEditar"
                onAction="#editarMaterial"
                prefHeight="40.0"
                prefWidth="170.0"
                style="-fx-background-color:#F3B200;
                       -fx-background-radius:8;"
                text="Editar"
                textFill="WHITE">

                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>

            </Button>


            <Button
                fx:id="btnAgregar"
                onAction="#agregarMaterial"
                prefHeight="40.0"
                prefWidth="170.0"
                style="-fx-background-color:#2563EB;
                       -fx-background-radius:8;"
                text="➕ Agregar"
                textFill="WHITE">

                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>

            </Button>

        </HBox>

    </VBox>

</center>
   <left>
      <VBox prefWidth="220"
          spacing="10"
          styleClass="sidebar">

        <padding>
            <Insets bottom="20" left="10" right="10" top="20" />
        </padding>

        <children>

            <Button fx:id="btnInicio"
                    onAction="#inicio"
                    prefHeight="40"
                    prefWidth="200"
                    styleClass="menu-button"
                    text="Inicio">
                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" top="120.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnMaterialesRegistrados"
                    onAction="#materialesRegistrados"
                    prefHeight="40"
                    prefWidth="200"
                    styleClass="menu-button"
                    text="Materiales Registrados">
                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnPrestamosActivos"
                    onAction="#prestamosActivos"
                    prefHeight="40"
                    prefWidth="200"
                    styleClass="menu-button"
                    text="Préstamos Activos">
                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnMaterialesDanados"
                    onAction="#materialesDanados"
                    prefHeight="40"
                    prefWidth="200"
                    styleClass="menu-button"
                    text="Materiales Dañados">
                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnReportes"
                    onAction="#reportes"
                    prefHeight="40"
                    prefWidth="200"
                    styleClass="menu-button"
                    text="Reportes">
                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Button>

            <Button fx:id="btnUsuarios"
                    onAction="#usuarios"
                    prefHeight="40"
                    prefWidth="200"
                    styleClass="menu-button"
                    text="Usuarios">
                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Button>

            <Pane VBox.vgrow="ALWAYS" />

            <Button fx:id="btnCuenta"
                    onAction="#cuenta"
                    prefHeight="40"
                    prefWidth="200"
                    styleClass="menu-button"
                    text="Cuenta">
                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>
            </Button>

        </children>
      </VBox>
   </left>
</BorderPane>
