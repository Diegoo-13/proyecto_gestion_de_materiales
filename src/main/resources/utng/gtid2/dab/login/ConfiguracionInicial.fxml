<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768.0" prefWidth="1366.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid2.dab.controllers.login.ConfiguracionInicialController">
   <children>
      <Pane layoutX="423.0" layoutY="51.0" prefHeight="672.0" prefWidth="520.0" style="-fx-background-color: #F4F7FC; -fx-border-color: #989898; -fx-background-radius: 10; -fx-border-radius: 10;">
         <effect><DropShadow offsetY="4.0" /></effect>
         <children>

            <Label layoutX="144.0" layoutY="70.0" text="Configuración inicial">
               <font><Font name="Segoe UI Bold" size="25.0" /></font>
            </Label>

            <Label layoutX="152.0" layoutY="109.0" text="Registre el administrador del sistema" textFill="#555555">
               <font><Font name="Segoe UI" size="14.0" /></font>
            </Label>

            <Label layoutX="74.0" layoutY="153.0" text="Nombre">
               <font><Font name="Segoe UI Bold" size="14.0" /></font>
            </Label>
            <TextField fx:id="txtNombre" layoutX="74.0" layoutY="177.0" prefHeight="35.0" prefWidth="372.0" promptText="Ingresa tu nombre" />

            <Label layoutX="74.0" layoutY="220.0" text="Apellido paterno">
               <font><Font name="Segoe UI Bold" size="14.0" /></font>
            </Label>
            <TextField fx:id="txtApellidoP" layoutX="74.0" layoutY="244.0" prefHeight="35.0" prefWidth="372.0" promptText="Ingresa tu apellido paterno" />

            <Label layoutX="74.0" layoutY="287.0" text="Apellido materno">
               <font><Font name="Segoe UI Bold" size="14.0" /></font>
            </Label>
            <TextField fx:id="txtApellidoM" layoutX="74.0" layoutY="311.0" prefHeight="35.0" prefWidth="372.0" promptText="Ingresa tu apellido materno" />

            <Label layoutX="74.0" layoutY="354.0" text="Nombre de usuario">
               <font><Font name="Segoe UI Bold" size="14.0" /></font>
            </Label>
            <TextField fx:id="txtUsuario" layoutX="74.0" layoutY="378.0" prefHeight="35.0" prefWidth="372.0" promptText="Ejemplo: administrador" />

            <Label layoutX="74.0" layoutY="421.0" text="Correo electrónico">
               <font><Font name="Segoe UI Bold" size="14.0" /></font>
            </Label>
            <TextField fx:id="txtCorreo" layoutX="74.0" layoutY="445.0" prefHeight="35.0" prefWidth="372.0" promptText="Ingresa tu correo" />

            <Label layoutX="74.0" layoutY="488.0" text="Contraseña">
               <font><Font name="Segoe UI Bold" size="14.0" /></font>
            </Label>
            <PasswordField fx:id="pwdContrasena" layoutX="74.0" layoutY="512.0" prefHeight="35.0" prefWidth="180.0" promptText="Contraseña" />

            <PasswordField fx:id="pwdConfirmar" layoutX="266.0" layoutY="512.0" prefHeight="35.0" prefWidth="180.0" promptText="Confirmar contraseña" />

            <Button fx:id="btnCrearAdministrador" layoutX="130.0" layoutY="567.0" mnemonicParsing="false" onAction="#crearAdministrador" prefHeight="35.0" prefWidth="270.0" style="-fx-background-color: #2563EB; -fx-background-radius: 8;" text="Crear administrador" textFill="WHITE">
               <font><Font name="Segoe UI Bold" size="15.0" /></font>
            </Button>
         </children>
      </Pane>
   </children>
</AnchorPane>
