<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0"
            prefWidth="1366.0"
            stylesheets="@../css/estilos.css"
            style="-fx-background-color: #F4F7FC;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="utng.gtid2.dab.controllers.danos.MaterialesDanadosController">

    <!-- ========================================================= -->
    <!-- MENÚ LATERAL -->
    <!-- ========================================================= -->

    <left>

        <VBox prefWidth="220.0"
              spacing="10.0"
              styleClass="sidebar">

            <padding>
                <Insets bottom="20.0"
                        left="10.0"
                        right="10.0"
                        top="20.0" />
            </padding>

            <!-- INICIO -->

            <Button fx:id="btnInicio"
                    onAction="#inicio"
                    prefHeight="40.0"
                    prefWidth="200.0"
                    styleClass="menu-button"
                    text="Inicio">

                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>

                <VBox.margin>
                    <Insets bottom="10.0"
                            top="120.0" />
                </VBox.margin>

            </Button>

            <!-- MATERIALES REGISTRADOS -->

            <Button fx:id="btnMaterialesRegistrados"
                    onAction="#materialesRegistrados"
                    prefHeight="40.0"
                    prefWidth="200.0"
                    styleClass="menu-button"
                    text="Materiales Registrados">

                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>

                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>

            </Button>

            <!-- PRÉSTAMOS -->

            <Button fx:id="btnPrestamosActivos"
                    onAction="#prestamosActivos"
                    prefHeight="40.0"
                    prefWidth="200.0"
                    styleClass="menu-button"
                    text="Préstamos Activos">

                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>

                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>

            </Button>

            <!-- MATERIALES DAÑADOS -->

            <Button fx:id="btnMaterialesDanados"
                    onAction="#materialesDanados"
                    prefHeight="40.0"
                    prefWidth="200.0"
                    styleClass="menu-button"
                    text="Materiales Dañados">

                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>

                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>

            </Button>

            <!-- REPORTES -->

            <Button fx:id="btnReportes"
                    onAction="#reportes"
                    prefHeight="40.0"
                    prefWidth="200.0"
                    styleClass="menu-button"
                    text="Reportes">

                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>

                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>

            </Button>

            <!-- USUARIOS -->

            <Button fx:id="btnUsuarios"
                    onAction="#usuarios"
                    prefHeight="40.0"
                    prefWidth="200.0"
                    styleClass="menu-button"
                    text="Usuarios">

                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>

                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>

            </Button>

            <!-- ESPACIO -->

            <Pane VBox.vgrow="ALWAYS" />

            <!-- CUENTA -->

            <Button fx:id="btnCuenta"
                    onAction="#cuenta"
                    prefHeight="40.0"
                    prefWidth="200.0"
                    styleClass="menu-button"
                    text="Cuenta"
                    textFill="WHITE">

                <font>
                    <Font name="Segoe UI Bold" size="15.0" />
                </font>

            </Button>

        </VBox>

    </left>


    <!-- ========================================================= -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ========================================================= -->

    <center>

        <VBox spacing="18.0"
              style="-fx-padding: 20;">

            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <HBox alignment="CENTER_LEFT">

                <VBox prefHeight="59.0"
                      prefWidth="463.0"
                      spacing="4.0">

                    <Label style="-fx-text-fill: #1F2937;"
                           text="Materiales Dañados">

                        <font>
                            <Font name="Segoe UI Bold"
                                  size="30.0" />
                        </font>

                    </Label>

                    <Label prefHeight="18.0"
                           prefWidth="500.0"
                           style="-fx-text-fill: #6B7280;"
                           text="Consulta y administra los materiales que han sido reportados como dañados.">

                        <font>
                            <Font name="Segoe UI"
                                  size="13.0" />
                        </font>

                    </Label>

                </VBox>


                <Pane prefHeight="59.0"
                      prefWidth="430.0"
                      HBox.hgrow="ALWAYS" />


                <!-- FECHA Y HORA -->

                <HBox 
                      alignment="CENTER"
                      prefHeight="60.0"
                      prefWidth="200.0"
                      spacing="20.0"
                      style="-fx-background-color: white;
                             -fx-padding: 10;
                             -fx-background-radius: 8;
                             -fx-border-color: #E5E7EB;
                             -fx-border-radius: 8;">

                    <children>

                        <Label fx:id="lblHora"
                               text="HORA"
                               textFill="#6B7280">

                            <font>
                                <Font name="Segoe UI Bold"
                                      size="15.0" />
                            </font>

                        </Label>


                        <Label fx:id="lblFecha"
                               text="FECHA"
                               textFill="#6B7280">

                            <font>
                                <Font name="Segoe UI Bold"
                                      size="15.0" />
                            </font>

                        </Label>

                    </children>

                </HBox>

            </HBox>


            <!-- ================================================= -->
            <!-- FILTROS -->
            <!-- ================================================= -->

            <HBox alignment="BOTTOM_LEFT"
                  spacing="15.0">

                <!-- BUSCAR -->

                <VBox spacing="5.0">

                    <Label style="-fx-text-fill: #374151;"
                           text="Buscar material">

                        <font>
                            <Font name="Segoe UI Bold"
                                  size="17.0" />
                        </font>

                    </Label>

                    <TextField fx:id="txtBuscar"
                               prefHeight="40.0"
                               prefWidth="320.0"
                               promptText="ID o nombre del material" />

                </VBox>


                <!-- ESTADO -->

                <VBox spacing="5.0">

                    <Label style="-fx-text-fill: #374151;"
                           text="Estado">

                        <font>
                            <Font name="Segoe UI Bold"
                                  size="17.0" />
                        </font>

                    </Label>

                    <ComboBox fx:id="cbEstado"
                              prefHeight="40.0"
                              prefWidth="170.0"
                              promptText="Todos" />

                </VBox>


                <!-- CATEGORÍA -->

                <VBox spacing="5.0">

                    <Label style="-fx-text-fill: #374151;"
                           text="Categoría">

                        <font>
                            <Font name="Segoe UI Bold"
                                  size="17.0" />
                        </font>

                    </Label>

                    <ComboBox fx:id="cbCategoria"
                              prefHeight="40.0"
                              prefWidth="170.0"
                              promptText="Todas" />

                </VBox>


                <!-- BUSCAR -->

                <Button fx:id="btnBuscar"
                        onAction="#buscar"
                        prefHeight="40.0"
                        prefWidth="120.0"
                        style="-fx-background-color: #2563EB;
                               -fx-background-radius: 8;"
                        text="🔍 Buscar"
                        textFill="WHITE">

                    <font>
                        <Font name="Segoe UI Bold"
                              size="15.0" />
                    </font>

                </Button>


                <!-- LIMPIAR -->

                <Button fx:id="btnLimpiar"
                        onAction="#limpiar"
                        prefHeight="40.0"
                        prefWidth="120.0"
                        style="-fx-background-color: white;
                               -fx-border-color: #D1D5DB;
                               -fx-border-radius: 8;
                               -fx-background-radius: 8;"
                        text="↻ Limpiar">

                    <font>
                        <Font name="Segoe UI"
                              size="15.0" />
                    </font>

                </Button>

            </HBox>


            <!-- ================================================= -->
            <!-- TARJETAS -->
            <!-- ================================================= -->

            <HBox spacing="20.0">

                <!-- TOTAL REPORTADOS -->

                <VBox prefHeight="110.0"
                      prefWidth="260.0"
                      spacing="8.0"
                      style="-fx-background-color: #EEF4FF;
                             -fx-background-radius: 10;
                             -fx-border-color: #D6E4FF;
                             -fx-border-radius: 10;
                             -fx-padding: 18;
                             -fx-border-width: 2;">

                    <Label style="-fx-text-fill: #374151;"
                           text="Total reportados">

                        <font>
                            <Font name="Segoe UI Bold"
                                  size="15.0" />
                        </font>

                    </Label>

                    <Label fx:id="lblTotalReportados"
                           alignment="CENTER"
                           prefHeight="50.0"
                           prefWidth="220.0"
                           text="0"
                           textFill="#1D4ED8">

                        <font>
                            <Font name="Segoe UI Bold"
                                  size="34.0" />
                        </font>

                    </Label>

                </VBox>


                <!-- EN REPARACIÓN -->

                <VBox prefHeight="110.0"
                      prefWidth="260.0"
                      spacing="8.0"
                      style="-fx-background-color: #FFF8E8;
                             -fx-background-radius: 10;
                             -fx-border-color: #F4D58D;
                             -fx-border-radius: 10;
                             -fx-padding: 18;">

                    <Label style="-fx-text-fill: #374151;"
                           text="En reparación">

                        <font>
                            <Font name="Segoe UI Bold"
                                  size="15.0" />
                        </font>

                    </Label>

                    <Label fx:id="lblEnReparacion"
                           alignment="CENTER"
                           prefHeight="50.0"
                           prefWidth="220.0"
                           text="0"
                           textFill="#D97706">

                        <font>
                            <Font name="Segoe UI Bold"
                                  size="34.0" />
                        </font>

                    </Label>

                </VBox>


                <!-- BAJA DEFINITIVA -->

                <VBox prefHeight="110.0"
                      prefWidth="260.0"
                      spacing="8.0"
                      style="-fx-background-color: #FFF0F0;
                             -fx-background-radius: 10;
                             -fx-border-color: #F5B5B5;
                             -fx-border-radius: 10;
                             -fx-padding: 18;">

                    <Label style="-fx-text-fill: #374151;"
                           text="Baja definitiva">

                        <font>
                            <Font name="Segoe UI Bold"
                                  size="15.0" />
                        </font>

                    </Label>

                    <Label fx:id="lblBajaDefinitiva"
                           alignment="CENTER"
                           prefHeight="50.0"
                           prefWidth="220.0"
                           text="0"
                           textFill="#DC2626">

                        <font>
                            <Font name="Segoe UI Bold"
                                  size="34.0" />
                        </font>

                    </Label>

                </VBox>

            </HBox>


            <!-- ================================================= -->
            <!-- TABLA -->
            <!-- ================================================= -->

            <VBox spacing="10.0">

                <TableView fx:id="tblMateriales"
                           prefHeight="350.0"
                           prefWidth="1005.0"
                           style="-fx-background-color: white;
                                  -fx-background-radius: 10;
                                  -fx-border-color: #D1D5DB;
                                  -fx-border-radius: 10;">

                    <columns>

                        <!-- ID -->

                        <TableColumn fx:id="colId"
                                     prefWidth="80.0"
                                     text="ID" />

                        <!-- MATERIAL -->

                        <TableColumn fx:id="colMaterial"
                                     prefWidth="235.0"
                                     text="Material" />

                        <!-- CATEGORÍA -->

                        <TableColumn fx:id="colCategoria"
                                     prefWidth="185.0"
                                     text="Categoría" />

                        <!-- FECHA -->

                        <TableColumn fx:id="colFecha"
                                     prefWidth="165.0"
                                     text="Fecha reporte" />

                        <!-- REPORTÓ -->

                        <TableColumn fx:id="colReporto"
                                     prefWidth="160.0"
                                     text="Reportó" />

                        <!-- ESTADO -->

                        <TableColumn fx:id="colEstado"
                                     prefWidth="145.0"
                                     text="Estado" />

                        <!-- OBSERVACIONES -->

                        <TableColumn fx:id="colObservaciones"
                                     prefWidth="300.0"
                                     text="Observaciones" />

                    </columns>

                </TableView>

            </VBox>


            <!-- ================================================= -->
            <!-- BOTONES -->
            <!-- ================================================= -->

            <HBox alignment="CENTER_RIGHT"
                  spacing="15.0">

                <!-- REPORTAR DAÑO -->

                <Button fx:id="btnReportarDano"
                        onAction="#reportarDano"
                        prefHeight="40.0"
                        prefWidth="190.0"
                        style="-fx-background-color: #2563EB;
                               -fx-background-radius: 8;"
                        text="➕ Reportar daño"
                        textFill="WHITE">

                    <font>
                        <Font name="Segoe UI Bold"
                              size="15.0" />
                    </font>

                </Button>


                <!-- ENVIAR A REPARACIÓN -->

                <Button fx:id="btnEnviarReparacion"
                        onAction="#enviarReparacion"
                        prefHeight="40.0"
                        prefWidth="210.0"
                        style="-fx-background-color: #F59E0B;
                               -fx-background-radius: 8;"
                        text="🔧 Enviar a reparación"
                        textFill="WHITE">

                    <font>
                        <Font name="Segoe UI Bold"
                              size="15.0" />
                    </font>

                </Button>


                <!-- RESTAURAR -->

                <Button fx:id="btnRestaurar"
                        onAction="#restaurar"
                        prefHeight="40.0"
                        prefWidth="150.0"
                        style="-fx-background-color: #16A34A;
                               -fx-background-radius: 8;"
                        text="✔ Restaurar"
                        textFill="WHITE">

                    <font>
                        <Font name="Segoe UI Bold"
                              size="15.0" />
                    </font>

                </Button>


                <!-- DAR DE BAJA -->

                <Button fx:id="btnBaja"
                        onAction="#baja"
                        prefHeight="40.0"
                        prefWidth="170.0"
                        style="-fx-background-color: #DC2626;
                               -fx-background-radius: 8;"
                        text="🗑 Dar de baja"
                        textFill="WHITE">

                    <font>
                        <Font name="Segoe UI Bold"
                              size="15.0" />
                    </font>

                </Button>

            </HBox>

        </VBox>

    </center>

</BorderPane>