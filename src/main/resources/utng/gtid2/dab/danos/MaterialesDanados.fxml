<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" style="-fx-background-color: #F4F7FC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid2.dab.controllers.danos.MaterialesDanadosController">

    <!-- ================= MENÚ LATERAL ================= -->

    <left>

        <VBox prefWidth="220" spacing="8" style="-fx-background-color: #1E3A8A;">

            <padding>
                <Insets bottom="15" left="10" right="10" top="15" />
            </padding>

            <Button fx:id="btnInicio" onAction="#inicio" prefHeight="40" prefWidth="200" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" text="Inicio" textFill="WHITE">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" top="100.0" />
            </VBox.margin></Button>

            <Button fx:id="btnMaterialesRegistrados" onAction="#materialesRegistrados" prefHeight="40" prefWidth="200" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" text="Materiales registrados" textFill="WHITE">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin></Button>

            <Button fx:id="btnPrestamosActivos" onAction="#prestamosActivos" prefHeight="40" prefWidth="200" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;" text="Préstamos activos" textFill="WHITE">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin></Button>

            <!-- Botón seleccionado -->

            <Button fx:id="btnMaterialesDanados" onAction="#materialesDanados" prefHeight="40" prefWidth="200" style="-fx-background-color: #1E3A8A; -fx-background-radius: 8; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;" text="Materiales dañados" textFill="WHITE">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin></Button>

            <Button fx:id="btnReportes" onAction="#reportes" prefHeight="40" prefWidth="200" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" text="Reportes" textFill="WHITE">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin></Button>

            <Button fx:id="btnUsuarios" onAction="#usuarios" prefHeight="40" prefWidth="200" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" text="Usuarios" textFill="WHITE">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font>
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin></Button>

            <Pane VBox.vgrow="ALWAYS" />

            <Button fx:id="btnCuenta" onAction="#cuenta" prefHeight="40" prefWidth="200" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" text="Cuenta" textFill="WHITE">
            <font>
               <Font name="Segoe UI Bold" size="15.0" />
            </font></Button>

        </VBox>

    </left>

    <!-- ================= CONTENIDO ================= -->

    <center>

        <VBox spacing="18" style="-fx-padding:20;">

            <!-- Encabezado -->

            <HBox alignment="CENTER_LEFT">

                <VBox prefHeight="59.0" prefWidth="463.0" spacing="4">

                    <Label style="-fx-text-fill: #1F2937;" text="Materiales Dañados">
                  <font>
                     <Font name="Segoe UI Bold" size="30.0" />
                  </font></Label>

                    <Label prefHeight="18.0" prefWidth="476.0" style="-fx-text-fill: #6B7280;" text="Consulta y administra los materiales que han sido reportados como dañados.">
                  <font>
                     <Font name="Segoe UI" size="13.0" />
                  </font></Label>

                </VBox>

                <Pane prefHeight="59.0" prefWidth="430.0" HBox.hgrow="ALWAYS" />

                <HBox fx:id="lblFechaHora" alignment="CENTER" prefHeight="60.0" prefWidth="200.0" spacing="20" style="-fx-background-color:white;                              -fx-padding:10;                              -fx-background-radius:8;                              -fx-border-color:#E5E7EB;                              -fx-border-radius:8;">
               <children>
                  <Label fx:id="lblHora" text="HORA" textFill="#6b7280">
                     <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblFecha" layoutX="21.0" layoutY="21.0" text="FECHA" textFill="#6b7280">
                     <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                     </font>
                  </Label>
               </children>

                </HBox>

            </HBox>

                        <!-- ================= FILTROS ================= -->

            <HBox alignment="BOTTOM_LEFT" spacing="15">

                <!-- Buscar -->

                <VBox spacing="5">

                    <Label style="-fx-text-fill: #374151;" text="Buscar material">
                  <font>
                     <Font name="Segoe UI Bold" size="17.0" />
                  </font></Label>

                    <TextField fx:id="txtBuscar" prefHeight="40" prefWidth="320" promptText="ID o nombre del material" />

                </VBox>

                <!-- Estado -->

                <VBox spacing="5">

                    <Label style="-fx-text-fill: #374151;" text="Estado">
                  <font>
                     <Font name="Segoe UI Bold" size="17.0" />
                  </font></Label>

                    <ComboBox fx:id="cbEstado" prefHeight="40" prefWidth="170" promptText="Todos" />

                </VBox>

                <!-- Categoría -->

                <VBox spacing="5">

                    <Label style="-fx-text-fill: #374151;" text="Categoría">
                  <font>
                     <Font name="Segoe UI Bold" size="17.0" />
                  </font></Label>

                    <ComboBox fx:id="cbCategoria" prefHeight="40" prefWidth="170" promptText="Todas" />

                </VBox>

                <!-- Botón Buscar -->

                <Button fx:id="btnBuscar" onAction="#buscar" prefHeight="40" prefWidth="120.0" style="-fx-background-color: #2563EB; -fx-background-radius: 8;" text="🔍 Buscar" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="15.0" />
               </font></Button>

                <!-- Botón Limpiar -->

                <Button fx:id="btnLimpiar" onAction="#limpiar" prefHeight="40" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #D1D5DB; -fx-border-radius: 8; -fx-background-radius: 8;" text="↻ Limpiar">
               <font>
                  <Font name="Segoe UI" size="15.0" />
               </font></Button>

            </HBox>

            <!-- ================= TARJETAS KPI ================= -->

            <HBox spacing="20">

                <!-- TARJETA 1 -->

                <VBox prefHeight="110" prefWidth="260.0" spacing="8" style="-fx-background-color: #EEF4FF; -fx-background-radius: 10; -fx-border-color: #D6E4FF; -fx-border-radius: 10; -fx-padding: 18; -fx-border-width: 2;">

                    <Label style="-fx-text-fill: #374151;" text="Total reportados">
                  <font>
                     <Font name="Segoe UI Bold" size="15.0" />
                  </font></Label>

                    <Label style="-fx-font-size:34;                                   -fx-font-weight:bold;                                   -fx-text-fill:#2563EB;">
                  <graphic>
                     <Label fx:id="lblTotalReportados" alignment="CENTER" prefHeight="50.0" prefWidth="320.0" text="0" textFill="#1d4ed8" />
                  </graphic></Label>

                </VBox>

                <!-- TARJETA 2 -->

                <VBox prefHeight="110" prefWidth="260.0" spacing="8" style="-fx-background-color:#FFF8E8;                              -fx-background-radius:10;                              -fx-border-color:#F4D58D;                              -fx-border-radius:10;                              -fx-padding:18;">

                    <Label style="-fx-font-weight:bold;" text="En evaluación">
                  <font>
                     <Font name="Segoe UI Bold" size="15.0" />
                  </font></Label>

                    <Label style="-fx-font-size:34;                                   -fx-font-weight:bold;                                   -fx-text-fill:#F59E0B;">
                  <graphic>
                     <Label fx:id="lblEnEvaluacion" alignment="CENTER" prefWidth="320.0" text="0" textFill="#d97706" />
                  </graphic></Label>

                </VBox>

                <!-- TARJETA 3 -->

                <VBox prefHeight="110" prefWidth="260.0" spacing="8" style="-fx-background-color:#FFF0F0;                              -fx-background-radius:10;                              -fx-border-color:#F5B5B5;                              -fx-border-radius:10;                              -fx-padding:18;">

                    <Label text="Baja definitiva">
                  <font>
                     <Font name="Segoe UI Bold" size="15.0" />
                  </font></Label>

                    <Label style="-fx-font-size:34;                                   -fx-font-weight:bold;                                   -fx-text-fill:#DC2626;">
                  <graphic>
                     <Label fx:id="lblBajaDefinitiva" alignment="CENTER" prefHeight="50.0" prefWidth="320.0" text="0" textFill="#dc2626" />
                  </graphic></Label>

                </VBox>

            </HBox>

                       <!-- ================= TABLA ================= -->

            <VBox spacing="10">

                <TableView fx:id="tblMateriales" prefHeight="350" prefWidth="1005.0" style="-fx-background-color:white;                                   -fx-background-radius:10;                                   -fx-border-color:#D1D5DB;                                   -fx-border-radius:10;">

                    <columns>

                        <TableColumn fx:id="colId" prefWidth="70" text="ID" />

                        <TableColumn fx:id="colMaterial" prefWidth="220" text="Material" />

                        <TableColumn fx:id="colCategoria" prefWidth="170" text="Categoría" />

                        <TableColumn fx:id="colFecha" prefWidth="150" text="Fecha reporte" />

                        <TableColumn fx:id="colReporto" prefWidth="150" text="Reportó" />

                        <TableColumn fx:id="colEstado" prefWidth="134.4000244140625" text="Estado" />

                        <TableColumn fx:id="colObservaciones" prefWidth="205.5999755859375" text="Observaciones" />

                    </columns>

                </TableView>

            </VBox>

            <!-- ================= BOTONES ================= -->

            <HBox alignment="CENTER_RIGHT" spacing="20">

                <Button fx:id="btnReportarDano" onAction="#reportarDano" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #2563EB; -fx-background-radius: 8;" text="➕ Reportar daño" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="15.0" />
               </font></Button>
            <Pane prefHeight="40.0" />

                <Button fx:id="btnRestaurar" onAction="#restaurar" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #16A34A; -fx-background-radius: 8;" text="✔ Restaurar" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="15.0" />
               </font></Button>

                <Button fx:id="btnBaja" onAction="#baja" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #DC2626; -fx-background-radius: 8;" text="🗑 Dar de baja" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="15.0" />
               </font></Button>

            </HBox>

        </VBox>

    </center>

</BorderPane>
