<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="650.0"
            prefWidth="614.0"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="utng.gtid2.dab.controllers.materiales.EditarMaterialController">

    <children>

        <BorderPane layoutX="1.0"
                    layoutY="-2.0"
                    prefHeight="650.0"
                    prefWidth="564.0">

            <left>

                <AnchorPane prefHeight="650.0"
                            prefWidth="606.0"
                            BorderPane.alignment="CENTER">

                    <children>

                        <Label layoutX="19.0"
                               layoutY="17.0"
                               text="Editar Material">
                            <font>
                                <Font name="Segoe UI Bold" size="28.0"/>
                            </font>
                        </Label>

                        <TextField fx:id="txtNombreMaterial"
                                   layoutX="23.0"
                                   layoutY="105.0"
                                   prefHeight="40.0"
                                   prefWidth="256.0"
                                   promptText="Nombre del material">
                            <font>
                                <Font size="15.0"/>
                            </font>
                        </TextField>

                        <ComboBox fx:id="cmbCategoria"
                                  layoutX="356.0"
                                  layoutY="105.0"
                                  prefHeight="40.0"
                                  prefWidth="230.0"/>

                        <RadioButton fx:id="rdbActivo"
                                     layoutX="29.0"
                                     layoutY="189.0"
                                     mnemonicParsing="false"
                                     text="Activo">
                            <font>
                                <Font name="Segoe UI" size="15.0"/>
                            </font>
                        </RadioButton>

                        <RadioButton fx:id="rdbConsumible"
                                     layoutX="121.0"
                                     layoutY="189.0"
                                     mnemonicParsing="false"
                                     text="Consumible">
                            <font>
                                <Font name="Segoe UI" size="15.0"/>
                            </font>
                        </RadioButton>

                        <ComboBox fx:id="cmbUbicacion"
                                  layoutX="353.0"
                                  layoutY="187.0"
                                  prefHeight="40.0"
                                  prefWidth="230.0"/>

                        <Spinner fx:id="spnStockMaximo"
                                 layoutX="22.0"
                                 layoutY="266.0"
                                 prefHeight="40.0"
                                 prefWidth="250.0"/>

                        <Spinner fx:id="spnStockMinimo"
                                 layoutX="23.0"
                                 layoutY="347.0"
                                 prefHeight="40.0"
                                 prefWidth="250.0"/>

                        <ComboBox fx:id="cmbUnidad"
                                  layoutX="353.0"
                                  layoutY="266.0"
                                  prefHeight="40.0"
                                  prefWidth="230.0"/>

                        <TextArea fx:id="txtaObservaciones"
                                  layoutX="19.0"
                                  layoutY="447.0"
                                  prefHeight="123.0"
                                  prefWidth="569.0"
                                  promptText="Observaciones"/>
                        <Label layoutX="23.0"
                               layoutY="82.0"
                               text="Nombre del material">
                            <font>
                                <Font name="Segoe UI Bold" size="14.0"/>
                            </font>
                        </Label>

                        <Label layoutX="357.0"
                               layoutY="80.0"
                               text="Categoría">
                            <font>
                                <Font name="Segoe UI Bold" size="14.0"/>
                            </font>
                        </Label>

                        <Label layoutX="29.0"
                               layoutY="162.0"
                               text="Tipo">
                            <font>
                                <Font name="Segoe UI Bold" size="14.0"/>
                            </font>
                        </Label>

                        <Label layoutX="356.0"
                               layoutY="160.0"
                               text="Ubicación">
                            <font>
                                <Font name="Segoe UI Bold" size="14.0"/>
                            </font>
                        </Label>

                        <Label layoutX="19.0"
                               layoutY="245.0"
                               text="Stock máximo">
                            <font>
                                <Font name="Segoe UI Bold" size="14.0"/>
                            </font>
                        </Label>

                        <Label layoutX="21.0"
                               layoutY="325.0"
                               text="Stock mínimo">
                            <font>
                                <Font name="Segoe UI Bold" size="14.0"/>
                            </font>
                        </Label>

                        <Label layoutX="353.0"
                               layoutY="245.0"
                               text="Unidad">
                            <font>
                                <Font name="Segoe UI Bold" size="14.0"/>
                            </font>
                        </Label>

                        <Label layoutX="20.0"
                               layoutY="415.0"
                               text="Observaciones (opcional)">
                            <font>
                                <Font name="Segoe UI Bold" size="14.0"/>
                            </font>
                        </Label>

                        <Button fx:id="btnCancelarCambios"
                                layoutX="306.0"
                                layoutY="583.0"
                                mnemonicParsing="false"
                                onAction="#cancelarCambios"
                                prefHeight="35.0"
                                prefWidth="120.0"
                                style="-fx-background-color: #EB2525; -fx-background-radius: 8;"
                                text="Cancelar"
                                textFill="WHITE">
                            <font>
                                <Font name="Segoe UI Bold" size="14.0"/>
                            </font>
                        </Button>

                        <Button fx:id="btnGuardarCambios"
                                layoutX="468.0"
                                layoutY="583.0"
                                mnemonicParsing="false"
                                onAction="#guardarCambios"
                                prefHeight="35.0"
                                prefWidth="120.0"
                                style="-fx-background-color: #2563EB; -fx-background-radius: 8;"
                                text="Actualizar"
                                textFill="WHITE">
                            <font>
                                <Font name="Segoe UI Bold" size="14.0"/>
                            </font>
                        </Button>

                        <Button fx:id="btnCerrarVentana"
                                layoutX="556.0"
                                layoutY="14.0"
                                mnemonicParsing="false"
                                onAction="#cerrarVentana"
                                prefHeight="31.0"
                                prefWidth="36.0"
                                style="-fx-background-color: #FF0000; -fx-background-radius: 8;"
                                text="✕"
                                textFill="WHITE"/>

                        <Separator layoutY="61.0"
                                   prefHeight="0.0"
                                   prefWidth="610.0"/>

                    </children>

                </AnchorPane>

            </left>

        </BorderPane>

    </children>

</AnchorPane>