<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER_LEFT" prefHeight="260.0" prefWidth="460.0" spacing="15.0" style="-fx-background-color: #F4F7FC; -fx-padding: 25; -fx-background-radius: 10;" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utng.gtid2.dab.controllers.usuarios.DesactivarUsuarioController">
   <children>
      <Label alignment="CENTER" prefHeight="38.0" prefWidth="391.0" text="⚠ Desactivar Usuario" textFill="RED">
         <font><Font name="Segoe UI Bold" size="30.0" /></font>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </Label>
      
      <Label prefHeight="49.0" prefWidth="410.0" text="¿Estás seguro de que deseas desactivar a este usuario? El usuario perderá acceso al sistema hasta que sea reactivado nuevamente." textFill="#475569" wrapText="true">
         <font><Font name="Segoe UI" size="14.0" /></font>
         <VBox.margin>
            <Insets top="-10.0" />
         </VBox.margin>
      </Label>

      <HBox alignment="CENTER" prefHeight="60.0" prefWidth="410.0" spacing="15.0">
         <children>
            <Button fx:id="btnCancelar" onAction="#cancelar" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #2563EB; -fx-background-radius: 8;" text="Cancelar" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="15.0" />
               </font></Button>
            <Button fx:id="btnDesactivar" onAction="#desactivar" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #FF0000; -fx-background-radius: 8;" text="Sí, Desactivar" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Bold" size="15.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin></Button>
         </children>
         <VBox.margin><Insets top="15.0" /></VBox.margin>
      </HBox>
   </children>
</VBox>
